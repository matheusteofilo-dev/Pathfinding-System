			<Item class="LocalScript" referent="RBX00000097">
				<Properties>
					<ProtectedString name="Source">--!nonstrict

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local gui = script.Parent
local toggleButton = gui:WaitForChild("DebugButton")
local panel = gui:WaitForChild("Panel")

local ON_COLOR = Color3.fromRGB(46, 160, 90)
local OFF_COLOR = Color3.fromRGB(110, 55, 55)

gui.Enabled = false
panel.Visible = false

local remote = ReplicatedStorage:WaitForChild("NPCDebugRemote", 30)
if not remote then
	return
end

local rows = {}
for _, row in ipairs(panel:GetChildren()) do
	local key = row.Name:match("^Row_(.+)$")
	local switch = key and row:FindFirstChild("Switch")
	if switch then
		rows[key] = { button = switch, value = false }
		switch.MouseButton1Click:Connect(function()
			remote:FireServer(key, not rows[key].value)
		end)
	end
end

toggleButton.MouseButton1Click:Connect(function()
	panel.Visible = not panel.Visible
end)

remote.OnClientEvent:Connect(function(state)
	if type(state) ~= "table" then
		return
	end
	gui.Enabled = true
	for key, r in pairs(rows) do
		local v = state[key] == true
		r.value = v
		r.button.Text = if v then "ON" else "OFF"
		r.button.BackgroundColor3 = if v then ON_COLOR else OFF_COLOR
	end
end)

remote:FireServer("sync")
</ProtectedString>
