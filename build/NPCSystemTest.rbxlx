		<Item class="ModuleScript" referent="RBXSYNC000002"><Properties><string name="Name">MovementService</string><ProtectedString name="Source">--!nonstrict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local MovementService = {}

function MovementService.start(config, emitNoise: (Vector3, number, string) -&gt; ())
	local cfg = config.movement
	if not cfg.enabled then
		return function() end
	end

	local remote = ReplicatedStorage:FindFirstChild("MovementInputRemote")
	if not remote then
		warn("[NPCSystem] MovementInputRemote not found in ReplicatedStorage; player movement noise is disabled.")
		return function() end
	end
	remote:SetAttribute("DoubleTapWindow", cfg.doubleTapWindow)

	local states = {}
	local connections = {}

	local function playSound(st, hrp: BasePart, action: string)
		local def = cfg.sounds[action]
		if not def then
			return
		end
		local sound = st.sounds[action]
		if not sound or sound.Parent ~= hrp then
			sound = Instance.new("Sound")
			sound.Name = "NPCSystem_" .. action
			sound.RollOffMode = Enum.RollOffMode.Linear
			sound.RollOffMaxDistance = cfg.soundMaxDistance
			sound.Parent = hrp
			st.sounds[action] = sound
		end
		sound.SoundId = def.id
		sound.Volume = def.volume
		sound.PlaybackSpeed = def.speed
		sound:Play()
	end

	local function act(st, hrp: BasePart, action: string)
		emitNoise(hrp.Position, cfg.noiseRadius[action], action)
		playSound(st, hrp, action)
	end

	local function newState()
		return { sprint = false, sneak = false, dist = 0, lastPos = nil, airSince = nil, groundMode = "walk", sounds = {}, lastInput = 0 }
	end

	local function hookCharacter(player: Player, character: Model)
		local st = states[player]
		if not st then
			return
		end
		st.lastPos, st.dist, st.airSince, st.sounds = nil, 0, nil, {}
		local hum = character:WaitForChild("Humanoid", 10)
		local hrp = character:WaitForChild("HumanoidRootPart", 10)
		if not hum or not hrp then
			return
		end
		table.insert(connections, hum.StateChanged:Connect(function(_, new)
			if new == Enum.HumanoidStateType.Jumping then
				st.airSince = os.clock()
				act(st, hrp, "jump")
			elseif new == Enum.HumanoidStateType.Freefall then
				st.airSince = st.airSince or os.clock()
			elseif new == Enum.HumanoidStateType.Landed then
				if st.airSince and os.clock() - st.airSince &gt;= cfg.minLandFallTime then
					act(st, hrp, "land")
				end
				st.airSince = nil
			elseif new == Enum.HumanoidStateType.Running or new == Enum.HumanoidStateType.RunningNoPhysics then
				st.airSince = nil
			end
		end))
	end

	local function addPlayer(player: Player)
		states[player] = newState()
		table.insert(connections, player.CharacterAdded:Connect(function(character)
			hookCharacter(player, character)
		end))
		if player.Character then
			task.spawn(hookCharacter, player, player.Character)
		end
	end

	for _, p in ipairs(Players:GetPlayers()) do
		addPlayer(p)
	end
	table.insert(connections, Players.PlayerAdded:Connect(addPlayer))
	table.insert(connections, Players.PlayerRemoving:Connect(function(p)
		states[p] = nil
	end))

	table.insert(connections, remote.OnServerEvent:Connect(function(player, sprint, sneak)
		local st = states[player]
		if not st or type(sprint) ~= "boolean" or type(sneak) ~= "boolean" then
			return
		end
		local now = os.clock()
		if now - st.lastInput &lt; 0.03 then
			return
		end
		st.lastInput = now
		st.sprint, st.sneak = sprint, sneak
	end))

	table.insert(connections, RunService.Heartbeat:Connect(function()
		for player, st in pairs(states) do
			local character = player.Character
			local hum = character and character:FindFirstChildOfClass("Humanoid")
			local hrp = character and character:FindFirstChild("HumanoidRootPart")
			if hum and hrp and hum.Health &gt; 0 then
				local airborne = hum.FloorMaterial == Enum.Material.Air
				if not airborne then
					local mode = if st.sprint then "sprint" elseif st.sneak then "sneak" else "walk"
					st.groundMode = mode
					hum.WalkSpeed = cfg.speeds[mode]

					local pos = hrp.Position
					if hum.MoveDirection.Magnitude &gt; 0.1 and st.lastPos then
						local d = math.sqrt((pos.X - st.lastPos.X) ^ 2 + (pos.Z - st.lastPos.Z) ^ 2)
						if d &lt; 20 then
							st.dist += d
						end
						if st.dist &gt;= cfg.stepDistance[mode] then
							st.dist = 0
							act(st, hrp, mode)
						end
					else
						st.dist = 0
					end
					st.lastPos = pos
				else
					st.lastPos = nil
				end
			end
		end
	end))

	return function()
		for _, c in ipairs(connections) do
			c:Disconnect()
		end
		table.clear(connections)
		table.clear(states)
	end
end

return MovementService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXSYNC000001"><Properties><string name="Name">GapSense</string><ProtectedString name="Source">--!nonstrict

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Vision = require(script.Parent.Vision)

local GapSense = {}

local function buildParams(ctrl): RaycastParams
	local list = { ctrl.model }
	if Vision.debugFolder then
		table.insert(list, Vision.debugFolder)
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then
			table.insert(list, p.Character)
		end
	end
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = list
	return rp
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function measure(ctrl, rp: RaycastParams, feet: Vector3, axis: Vector3, rays)
	local cfg = ctrl.config.gap
	local perp = Vector3.new(-axis.Z, 0, axis.X)
	local best = nil
	for _, h in ipairs(cfg.heights) do
		local origin = feet + Vector3.new(0, h, 0)
		local l = Workspace:Raycast(origin, perp * cfg.probeRange, rp)
		local r = Workspace:Raycast(origin, -perp * cfg.probeRange, rp)
		local dl = if l then l.Distance else cfg.probeRange
		local dr = if r then r.Distance else cfg.probeRange
		if rays then
			table.insert(rays, { from = origin, to = if l then l.Position else origin + perp * cfg.probeRange })
			table.insert(rays, { from = origin, to = if r then r.Position else origin - perp * cfg.probeRange })
		end
		local width = dl + dr
		if best == nil or width &lt; best.width then
			best = { width = width, bothHit = l ~= nil and r ~= nil, dl = dl, dr = dr, nl = l and l.Normal, nr = r and r.Normal }
		end
	end
	best.mid = feet + perp * ((best.dl - best.dr) / 2)
	return best
end

local function isNarrow(ctrl, m): boolean
	local diameter = ctrl.profile.agent.radius * 2
	return m.bothHit and m.width &lt; diameter and m.width &gt;= ctrl.config.gap.minWidth
end

local function refineAxis(m, axis: Vector3): Vector3
	if not (m.nl and m.nr) then
		return axis
	end
	local sum = flat(m.nr) - flat(m.nl)
	if sum.Magnitude &lt; 0.2 then
		return axis
	end
	local perp = sum.Unit
	local refined = Vector3.new(perp.Z, 0, -perp.X)
	if refined:Dot(axis) &lt; 0 then
		refined = -refined
	end
	return refined
end

function GapSense.learn(ctrl, feet: Vector3, dir: Vector3, rays)
	local cfg = ctrl.config.gap
	for _, g in ipairs(ctrl.gaps) do
		if (g.center - feet).Magnitude &lt; cfg.mergeDistance then
			return nil
		end
	end
	if #ctrl.gaps &gt;= cfg.maxGaps then
		return nil
	end
	local rp = buildParams(ctrl)
	local m0 = measure(ctrl, rp, feet, dir, rays)
	if not isNarrow(ctrl, m0) then
		return nil
	end

	local axis = refineAxis(m0, dir)
	local m1 = measure(ctrl, rp, feet, axis, rays)
	if not isNarrow(ctrl, m1) then
		axis, m1 = dir, m0
	end
	local center = m1.mid
	local diameter = ctrl.profile.agent.radius * 2

	local function boundary(sign: number): number?
		for s = cfg.marchStep, cfg.marchRange, cfg.marchStep do
			local p = center + axis * (sign * s)
			local m = measure(ctrl, rp, p, axis, rays)
			if not (m.bothHit and m.width &lt; diameter) then
				return s + cfg.entryBackoff
			end
		end
		return nil
	end
	local back, ahead = boundary(-1), boundary(1)
	if not back or not ahead then
		return nil
	end
	return {
		center = center,
		dir = axis,
		entry = center - axis * back,
		exit = center + axis * ahead,
		width = m1.width,
		learnedAt = os.clock(),
	}
end

function GapSense.pick(ctrl, goal: Vector3)
	local pos = ctrl.root.Position
	local maxApproach = ctrl.config.gap.maxApproach
	local bodyDepth = ctrl.profile.agent.bodyDepth or ctrl.config.gap.bodyDepth
	local best, bestCost = nil, math.huge
	for _, g in ipairs(ctrl.gaps) do
		if g.width &gt;= bodyDepth then
			for _, pair in ipairs({ { g.entry, g.exit }, { g.exit, g.entry } }) do
				local from, to = pair[1], pair[2]
				local approach = (from - pos).Magnitude
				local before, after = (goal - from).Magnitude, (goal - to).Magnitude
				if approach &lt;= maxApproach and after &lt; before - 0.5 then
					local cost = approach + after
					if cost &lt; bestCost then
						bestCost = cost
						best = { from = from, center = g.center, to = to, axis = g.dir }
					end
				end
			end
		end
	end
	return best
end

return GapSense
