			</Item>
			<Item class="ModuleScript" referent="RBX00000003">
				<Properties>
					<Content name="LinkedSource"><null /></Content>
					<ProtectedString name="Source">--!nonstrict

local Workspace = game:GetService("Workspace")

local Debug = {}
Debug.__index = Debug

local COLORS = {
	visible = Color3.fromRGB(60, 255, 90),
	blocked = Color3.fromRGB(255, 60, 60),
	search = Color3.fromRGB(255, 225, 0),
	ghost = Color3.fromRGB(255, 255, 255),
	noise = Color3.fromRGB(0, 230, 255),
	hearing = Color3.fromRGB(70, 110, 255),
	path = Color3.fromRGB(180, 130, 255),
	pathCurrent = Color3.fromRGB(255, 255, 255),
	gap = Color3.fromRGB(200, 60, 255),
}

local function newPart(): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Massless = true
	p.Locked = true
	p.Material = Enum.Material.Neon
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	return p
end

function Debug.new(config)
	local folder = Workspace:FindFirstChild("NPCSystemDebug")
	if folder then
		folder:ClearAllChildren()
	else
		folder = Instance.new("Folder")
		folder.Name = "NPCSystemDebug"
		folder.Parent = Workspace
	end
	return setmetatable({
		cfg = config.debug,
		enabled = false,
		folder = folder,
		pool = {},
		timed = {},
		live = 0,
		dropped = 0,
		per = {},
	}, Debug)
end

function Debug:_acquire(): Part?
	if self.live &gt;= self.cfg.maxVisualParts then
		self.dropped += 1
		return nil
	end
	local p = table.remove(self.pool) or newPart()
	p.Shape = Enum.PartType.Block
	p.Transparency = 0
	p.Material = Enum.Material.Neon
	self.live += 1
	p.Parent = self.folder
	return p
end

function Debug:_release(p: Part)
	p.Parent = nil
	p.Name = "Part"
	self.live -= 1
	if #self.pool &lt; 400 then
		table.insert(self.pool, p)
	else
		p:Destroy()
	end
end

function Debug:_line(a: Vector3, b: Vector3, color: Color3, thickness: number, life: number): Part?
	local p = self:_acquire()
	if not p then
		return nil
	end
	local len = (b - a).Magnitude
	if len &lt; 0.02 then
		len = 0.02
		b = a + Vector3.new(0, 0, 0.02)
	end
	p.Size = Vector3.new(thickness, thickness, len)
	p.CFrame = CFrame.lookAt(a, b) * CFrame.new(0, 0, -len / 2)
	p.Color = color
	table.insert(self.timed, { part = p, expires = os.clock() + life })
	return p
end

function Debug:_ball(pos: Vector3, diameter: number, color: Color3, transparency: number, life: number): Part?
	local p = self:_acquire()
	if not p then
		return nil
	end
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(diameter, diameter, diameter)
	p.CFrame = CFrame.new(pos)
	p.Color = color
	p.Transparency = transparency
	table.insert(self.timed, { part = p, expires = os.clock() + life })
	return p
end

function Debug:setEnabled(on: boolean)
	if on == self.enabled then
		return
	end
	self.enabled = on
	if not on then
		self:clear()
	end
end

function Debug:clear()
	for _, t in ipairs(self.timed) do
		self:_release(t.part)
	end
	table.clear(self.timed)
	for ctrl in pairs(self.per) do
		self:removeController(ctrl)
	end
	self.dropped = 0
	self.folder:ClearAllChildren()
	for _, p in ipairs(self.pool) do
		p:Destroy()
	end
	table.clear(self.pool)
	self.live = 0
end

function Debug:stats()
	return { live = self.live, pooled = #self.pool, timed = #self.timed, dropped = self.dropped, folderChildren = #self.folder:GetChildren() }
end

function Debug:addVisionRays(ctrl, rays)
	if not (self.enabled and self.cfg.showVisionRays) then
		return
	end
	local life = self.cfg.rayLifetime
	local rec = self:_rec(ctrl)
	rec.blockers = {}
	for _, r in ipairs(rays) do
		local part = self:_line(r.from, r.to, if r.visible then COLORS.visible else COLORS.blocked, 0.06, life)
		if r.blockedBy then
			if #rec.blockers &lt; 4 then
				table.insert(rec.blockers, r.blockedBy.Name)
			end
			if part then
				part:SetAttribute("BlockedBy", r.blockedBy:GetFullName())
			end
		elseif not r.visible and part then
			part:SetAttribute("BlockedBy", "(no impact)")
		end
		if part then
			part:SetAttribute("Sample", r.sample)
		end
	end
end

function Debug:addSearchRays(ctrl, rays)
	if not (self.enabled and self.cfg.showSearchRays) then
		return
	end
	for _, r in ipairs(rays) do
		local part = self:_line(r.from, r.to, COLORS.search, 0.05, self.cfg.rayLifetime * 4)
		if part and r.blockedBy then
			part:SetAttribute("BlockedBy", r.blockedBy:GetFullName())
		end
	end
end

function Debug:addNoise(event)
	if not (self.enabled and self.cfg.showNoise) then
		return
	end

	local styles = self.cfg.noiseStyle
	local style = (event.tag and styles and styles[event.tag]) or (styles and styles.default) or { color = COLORS.noise, lifetime = self.cfg.noiseLifetime }
	local sphere = self:_ball(event.position, math.max(event.radius * 2, 0.2), style.color, 0.88, style.lifetime)
	if sphere then
		sphere.Name = "Noise_" .. tostring(event.tag or "manual")
	end
	self:_ball(event.position, 1.2, style.color, 0, style.lifetime)
end

function Debug:addGapRays(ctrl, rays)
	if not (self.enabled and self.cfg.showGaps) then
		return
	end
	for _, r in ipairs(rays) do
		self:_line(r.from, r.to, COLORS.gap, 0.04, 0.3)
	end
end

function Debug:_rec(ctrl)
	local rec = self.per[ctrl]
	if not rec then
		rec = { ghostVersion = -1, pathSig = "", blockers = {}, labelAt = 0 }
		self.per[ctrl] = rec
	end
	return rec
end

local function destroyIf(inst)
	if inst then
		inst:Destroy()
	end
end

function Debug:removeController(ctrl)
	local rec = self.per[ctrl]
	if not rec then
		return
	end
	destroyIf(rec.ghost)
	destroyIf(rec.pathFolder)
	destroyIf(rec.labelPart)
	destroyIf(rec.hearing)
	destroyIf(rec.gapFolder)
	self.per[ctrl] = nil
end

local function fmt(v: Vector3?): string
	if not v then
		return "-"
	end
	return ("(%.0f, %.0f, %.0f)"):format(v.X, v.Y, v.Z)
end

function Debug:_updateGhost(ctrl, rec)
	local v = ctrl.visual

	local want = self.cfg.showLastSeenGhost and v ~= nil and v.visible == false and v.pose ~= nil
	if not want then
		if rec.ghost then
			rec.ghost:Destroy()
			rec.ghost = nil
			rec.ghostVersion = -1
		end
		return
	end
	if rec.ghost and rec.ghostVersion == v.poseVersion then
		return
	end
	destroyIf(rec.ghost)
	local model = Instance.new("Model")
	model.Name = ("LastSeenGhost_%d_%d"):format(ctrl.id, v.player.UserId)
	for _, entry in ipairs(v.pose) do
		local p = newPart()
		p.Name = entry.name
		p.Material = Enum.Material.SmoothPlastic
		p.Color = COLORS.ghost
		p.Transparency = 0.55
		p.Size = entry.size
		p.CFrame = entry.cframe
		p.Parent = model
	end
	model.Parent = self.folder
	rec.ghost = model
	rec.ghostVersion = v.poseVersion
end

function Debug:_updatePath(ctrl, rec)
	local nav = ctrl.nav
	local wps = nav.waypoints
	if not (self.cfg.showPaths and wps and nav.status == "Moving") then
		if rec.pathFolder then
			rec.pathFolder:Destroy()
			rec.pathFolder = nil
			rec.pathSig = ""
		end
		return
	end
	local sig = nav.pathVersion .. ":" .. nav.wpIndex
	if sig == rec.pathSig then
		return
	end
	rec.pathSig = sig
	destroyIf(rec.pathFolder)
	local folder = Instance.new("Folder")
	folder.Name = "Path_" .. ctrl.id
	local up = Vector3.new(0, 0.6, 0)
	for i = math.max(1, nav.wpIndex - 1), #wps do
		local p = newPart()
		p.Shape = Enum.PartType.Ball
		local current = i == nav.wpIndex
		local d = if current then 1.1 else 0.55
		p.Size = Vector3.new(d, d, d)
		p.Color = if current then COLORS.pathCurrent else COLORS.path
		p.CFrame = CFrame.new(wps[i].Position + up)
		p.Parent = folder
		if i &lt; #wps then
			local a, b = wps[i].Position + up, wps[i + 1].Position + up
			local len = math.max((b - a).Magnitude, 0.02)
			local seg = newPart()
			seg.Size = Vector3.new(0.12, 0.12, len)
			seg.CFrame = CFrame.lookAt(a, b + Vector3.new(0, 0, 0.0001)) * CFrame.new(0, 0, -len / 2)
			seg.Color = COLORS.path
			seg.Parent = folder
		end
	end
	folder.Parent = self.folder
	rec.pathFolder = folder
end

function Debug:_updateGaps(ctrl, rec)
	if not self.cfg.showGaps or #ctrl.gaps == 0 then
		if rec.gapFolder then
			rec.gapFolder:Destroy()
			rec.gapFolder = nil
			rec.gapCount = 0
		end
		return
	end
	if rec.gapCount == #ctrl.gaps and rec.gapFolder then
		return
	end
	rec.gapCount = #ctrl.gaps
	destroyIf(rec.gapFolder)
	local folder = Instance.new("Folder")
	folder.Name = "Gaps_" .. ctrl.id
	for _, g in ipairs(ctrl.gaps) do
		local a, b = g.entry + Vector3.new(0, 0.5, 0), g.exit + Vector3.new(0, 0.5, 0)
		local len = math.max((b - a).Magnitude, 0.05)
		local seg = newPart()
		seg.Name = "KnownGap"
		seg.Size = Vector3.new(0.2, 0.2, len)
		seg.CFrame = CFrame.lookAt(a, b) * CFrame.new(0, 0, -len / 2)
		seg.Color = COLORS.gap
		seg.Parent = folder
		for _, p in ipairs({ a, b }) do
			local ball = newPart()
			ball.Shape = Enum.PartType.Ball
			ball.Size = Vector3.new(0.9, 0.9, 0.9)
			ball.Color = COLORS.gap
			ball.CFrame = CFrame.new(p)
			ball.Parent = folder
		end
	end
	folder.Parent = self.folder
	rec.gapFolder = folder
end

function Debug:_updateLabel(ctrl, rec, now: number)
	if not self.cfg.showState then
		destroyIf(rec.labelPart)
		rec.labelPart = nil
		return
	end
	if not rec.labelPart then
		local part = newPart()
		part.Transparency = 1
		part.Size = Vector3.new(0.2, 0.2, 0.2)
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.fromOffset(300, 150)
		gui.StudsOffset = Vector3.new(0, 1.5, 0)
		gui.AlwaysOnTop = true
		gui.Adornee = part
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 0.55
		label.BackgroundColor3 = Color3.new(0, 0, 0)
		label.TextColor3 = Color3.new(1, 1, 1)
		label.TextSize = 13
		label.Font = Enum.Font.Code
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.TextYAlignment = Enum.TextYAlignment.Top
		label.Parent = gui
		gui.Parent = part
		part.Parent = self.folder
		rec.labelPart, rec.label = part, label
	end
	rec.labelPart.CFrame = CFrame.new(ctrl.root.Position + Vector3.new(0, 5, 0))
	if now - rec.labelAt &lt; self.cfg.labelRefreshInterval then
		return
	end
	rec.labelAt = now
	local nav, v, n = ctrl.nav, ctrl.visual, ctrl.noise
	local lines = {
		("%s #%d [%s]"):format(ctrl.model.Name, ctrl.id, ctrl.state),
		"reason: " .. ctrl.stateReason,
		("target: %s %s"):format(if v then v.player.Name else "-", if v then (if v.visible then "(visible)" else "(lost)") else ""),
		("dest req %s nav %s%s"):format(fmt(nav.requested), fmt(nav.destination), if nav.usedAlternate then " [alt]" else ""),
		("nav %s attempts %d/%d repath: %s"):format(nav.status, nav.attempts, ctrl.config.navigation.maxRecoveryAttempts, tostring(nav.lastRepathReason)),
		("note: %s"):format(tostring(nav.lastRecoveryNote or nav.failReason or "-")),
		("noise q=%d heard=%d grp=%d rej=%d exp=%d ign=%d"):format(#n.queue, n.stats.heard, n.stats.grouped, n.stats.rejected, n.stats.expired, n.stats.ignored),
		("blockers: %s"):format(table.concat(rec.blockers, ",")),
		("gaps known: %d  squeeze: %s"):format(#ctrl.gaps, if ctrl.squeeze then ctrl.squeeze.stage else "-"),
		("dropped visuals: %d"):format(self.dropped),
	}
	rec.label.Text = table.concat(lines, "\n")
end

function Debug:_updateHearing(ctrl, rec)
	if not self.cfg.showHearingRange or ctrl.profile.hearing &lt;= 0 then
		destroyIf(rec.hearing)
		rec.hearing = nil
		return
	end
	if not rec.hearing then
		local p = newPart()
		p.Shape = Enum.PartType.Ball
		p.Color = COLORS.hearing
		p.Transparency = 0.93
		local d = ctrl.profile.hearing * 2
		p.Size = Vector3.new(d, d, d)
		p.Name = "HearingRange"
		p.Parent = self.folder
		rec.hearing = p
	end
	rec.hearing.CFrame = CFrame.new(ctrl.root.Position)
end

function Debug:update(controllers: { any })
	if not self.enabled then
		return
	end
	local now = os.clock()

	local timed = self.timed
	local i = 1
	while i &lt;= #timed do
		local t = timed[i]
		if t.expires &lt;= now then
			self:_release(t.part)
			timed[i] = timed[#timed]
			timed[#timed] = nil
		else
			i += 1
		end
	end

	for _, ctrl in ipairs(controllers) do
		if ctrl:isActive() then
			local rec = self:_rec(ctrl)
			self:_updateGhost(ctrl, rec)
			self:_updatePath(ctrl, rec)
			self:_updateGaps(ctrl, rec)
			self:_updateLabel(ctrl, rec, now)
			self:_updateHearing(ctrl, rec)
		end
	end
end

return Debug
</ProtectedString>
					<string name="ScriptGuid">{8E93602A-3BD6-4091-9CD3-7E0F7F2022C3}</string>
					<BinaryString name="AttributesSerialize" />
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">DebugRenderer</string>
					<BinaryString name="SerializedOverrides" />
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">5d7d750ab0696d8c0afebac10000043a</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000004">
				<Properties>
					<Content name="LinkedSource"><null /></Content>
					<ProtectedString name="Source">--!nonstrict

local PathfindingService = game:GetService("PathfindingService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Vision = require(script.Parent.Vision)

local Navigator = {}
Navigator.__index = Navigator

local activeComputes = 0

local function flatDistance(a: Vector3, b: Vector3): number
	local dx, dz = a.X - b.X, a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

function Navigator.new(ctrl)
	return setmetatable({
		ctrl = ctrl,
		cfg = ctrl.config.navigation,
		ctrlConfig = ctrl.config,
		humanoid = ctrl.humanoid,
		root = ctrl.root,
		status = "Idle",
		failReason = nil,
		failedAt = -math.huge,
		routeMode = false,
		sidewaysFacing = nil,
		crossLine = nil,
		arrivalTol = ctrl.config.navigation.arrivalTolerance,
		consumed = true,
		requested = nil,
		destination = nil,
		usedAlternate = false,
		goalReason = nil,
		waypoints = nil,
		wpIndex = 1,
		pathVersion = 0,
		computeGen = 0,
		inflight = 0,
		pendingRepath = nil,
		lastRepathAt = -math.huge,
		lastRepathReason = nil,
		goalStartedAt = 0,
		attempts = 0,
		lastRecoveryNote = nil,
		blockedCount = 0,
		blockedConn = nil,
		sidestepUntil = 0,
		sidestepPoint = nil,
		sideSign = 1,
		useAlternate = false,
		lastMoveCmdAt = -math.huge,
		cmdIndex = 0,
		jumpedIndex = 0,
		bestDist = math.huge,
		lastProgressAt = os.clock(),
		lastPos = ctrl.root.Position,
		distSinceRecovery = 0,
		incapSince = nil,
		destroyed = false,
	}, Navigator)
end

function Navigator:_agentParams()
	local a = self.ctrl.profile.agent
	return {
		AgentRadius = a.radius,
		AgentHeight = a.height,
		AgentCanJump = a.canJump,
		AgentCanClimb = a.canClimb,
		Costs = a.costs,
	}
end

function Navigator:_disconnectBlocked()
	if self.blockedConn then
		self.blockedConn:Disconnect()
		self.blockedConn = nil
	end
end

function Navigator:remainingPathLength(): number?
	local wps = self.waypoints
	if not wps or self.routeMode or self.wpIndex &gt; #wps then
		return nil
	end
	local total = (wps[self.wpIndex].Position - self.root.Position).Magnitude
	for i = self.wpIndex, #wps - 1 do
		total += (wps[i + 1].Position - wps[i].Position).Magnitude
	end
	return total
end

function Navigator:_endSideways()
	if self.sidewaysFacing then
		self.sidewaysFacing = nil
		self.crossLine = nil
		if self.humanoid.Parent then
			self.humanoid.AutoRotate = true
			self.humanoid.WalkSpeed = self.ctrl.profile.speed
		end
	end
end

function Navigator:_stopMoving()
	local hum = self.humanoid
	if hum.Parent and hum.Health &gt; 0 then
		hum:MoveTo(self.root.Position)
	end
end

function Navigator:_snapGround(position: Vector3): (Vector3, boolean)
	local list = { self.ctrl.model }
	if Vision.debugFolder then
		table.insert(list, Vision.debugFolder)
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then
			table.insert(list, p.Character)
		end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = list
	local result = Workspace:Raycast(position + Vector3.new(0, 2, 0), Vector3.new(0, -self.cfg.groundSnapDepth, 0), params)
	if result then
		return result.Position, true
	end
	return position, false
end

function Navigator:_stale(gen: number): boolean
	return self.destroyed or gen ~= self.computeGen
end

function Navigator:setGoal(position: Vector3, reason: string, precise: boolean?)
	local now = os.clock()
	self:_endSideways()
	self.routeMode = false
	self.arrivalTol = if precise then self.cfg.preciseArrivalTolerance else self.cfg.arrivalTolerance
	self:_disconnectBlocked()
	self.computeGen += 1
	self.waypoints = nil
	self.requested = position
	self.destination = nil
	self.usedAlternate = false
	self.goalReason = reason
	self.attempts = 0
	self.useAlternate = false
	self.failReason = nil
	self.consumed = false
	self.pendingRepath = nil
	self.sidestepUntil = 0
	self.goalStartedAt = now
	self.distSinceRecovery = 0
	self.lastPos = self.root.Position

	local pos = self.root.Position
	if flatDistance(pos, position) &lt;= self.arrivalTol and math.abs(pos.Y - position.Y) &lt;= self.cfg.verticalTolerance + 3 then
		self.destination = position
		self:_arrive()
		return
	end
	self.status = "Computing"
	self:_requestPath("new goal", true)
end

function Navigator:setRoute(points: { Vector3 }, reason: string, facing: Vector3?, lineOrigin: Vector3?)
	local now = os.clock()
	self:_endSideways()
	if facing then
		self.sidewaysFacing = facing
		self.humanoid.AutoRotate = false
		self.humanoid.WalkSpeed = self.ctrl.profile.speed * self.ctrlConfig.gap.crossSpeedFactor
		local origin = lineOrigin or points[1]
		local last = points[#points]
		local delta = Vector3.new(last.X - origin.X, 0, last.Z - origin.Z)
		if delta.Magnitude &gt; 0.01 then
			self.crossLine = { origin = origin, axis = delta.Unit, length = delta.Magnitude }
		end
	end
	self:_disconnectBlocked()
	self.computeGen += 1
	self.routeMode = true
	self.arrivalTol = self.cfg.preciseArrivalTolerance
	self.requested = points[#points]
	self.destination = points[#points]
	self.usedAlternate = false
	self.goalReason = reason
	self.attempts = 0
	self.useAlternate = false
	self.failReason = nil
	self.consumed = false
	self.pendingRepath = nil
	self.sidestepUntil = 0
	self.goalStartedAt = now
	self.distSinceRecovery = 0
	self.lastPos = self.root.Position
	local wps = {}
	for i, p in ipairs(points) do
		local prev = points[i - 1]
		local jump = prev ~= nil and p.Y - prev.Y &gt; 2.5
		wps[i] = { Position = p, Action = if jump then Enum.PathWaypointAction.Jump else Enum.PathWaypointAction.Walk }
	end
	self.waypoints = wps
	self.wpIndex = 1
	self.pathVersion += 1
	self.status = "Moving"
	self.bestDist = math.huge
	self.lastProgressAt = now
	self.lastMoveCmdAt = -math.huge
	self.cmdIndex = 0
end

function Navigator:updateGoal(position: Vector3, reason: string)
	local now = os.clock()
	local status = self.status
	if self.requested and status ~= "Idle" then
		if (position - self.requested).Magnitude &lt; self.cfg.targetMoveThreshold then
			if status ~= "Failed" or now - self.failedAt &lt; 1 then
				return
			end
		end
	end
	if now - self.lastRepathAt &lt; self.cfg.repathInterval then
		return
	end
	if status == "Moving" or status == "Computing" then
		self.requested = position
		self:_requestPath("target moved", false)
	else
		self:setGoal(position, reason)
	end
end

function Navigator:stop()
	self:_endSideways()
	self:_disconnectBlocked()
	self.computeGen += 1
	self.waypoints = nil
	self.requested = nil
	self.destination = nil
	self.pendingRepath = nil
	self.status = "Idle"
	self.consumed = true
	self.sidestepUntil = 0
	self:_stopMoving()
end

function Navigator:destroy()
	self:_endSideways()
	self.destroyed = true
	self:_disconnectBlocked()
	self.computeGen += 1
	self.waypoints = nil
end

function Navigator:_arrive()
	self:_endSideways()
	self.status = "Arrived"
	self.consumed = false
	self.waypoints = nil
	self:_disconnectBlocked()
	self:_stopMoving()
end

function Navigator:_fail(reason: string)
	self:_endSideways()
	self.status = "Failed"
	self.failReason = reason
	self.failedAt = os.clock()
	self.consumed = false
	self.waypoints = nil
	self.computeGen += 1
	self:_disconnectBlocked()
	self:_stopMoving()
end

function Navigator:_requestPath(why: string, force: boolean)
	if self.destroyed or self.requested == nil or self.routeMode then
		return
	end
	local now = os.clock()
	local minGap = if force then 0.15 else self.cfg.repathInterval
	if now - self.lastRepathAt &lt; minGap or activeComputes &gt;= self.cfg.maxConcurrentComputes or self.inflight &gt;= 2 then
		self.pendingRepath = why
		return
	end
	self.pendingRepath = nil
	self.lastRepathAt = now
	self.lastRepathReason = why
	self.computeGen += 1
	local gen = self.computeGen
	local target = self.requested
	local useAlt = self.useAlternate
	self.inflight += 1
	activeComputes += 1
	task.spawn(function()
		local ok, err = pcall(self._compute, self, gen, target, useAlt)
		self.inflight -= 1
		activeComputes -= 1
		if not ok then
			warn(("[NPCSystem] path compute error for %s: %s"):format(self.ctrl.model.Name, tostring(err)))
			if not self:_stale(gen) then
				self:_fail("compute-error")
			end
		end
	end)
end

function Navigator:_newPath(from: Vector3, to: Vector3)
	local path = PathfindingService:CreatePath(self:_agentParams())
	local ok = pcall(function()
		path:ComputeAsync(from, to)
	end)
	if ok and path.Status == Enum.PathStatus.Success then
		return path
	end
	return nil
end

function Navigator:_findAlternate(origin: Vector3, dest: Vector3, gen: number)
	local cfg = self.cfg
	local candidates = {}
	for _, radius in ipairs(cfg.alternateRadii) do
		for i = 0, cfg.alternateDirections - 1 do
			local a = (i / cfg.alternateDirections) * 2 * math.pi
			local p = dest + Vector3.new(math.cos(a) * radius, 0, math.sin(a) * radius)
			table.insert(candidates, { point = p, radius = radius, toOrigin = (p - origin).Magnitude })
		end
	end
	table.sort(candidates, function(x, y)
		if x.radius ~= y.radius then
			return x.radius &lt; y.radius
		end
		return x.toOrigin &lt; y.toOrigin
	end)
	local tried = 0
	for _, c in ipairs(candidates) do
		if tried &gt;= cfg.maxAlternatePoints then
			break
		end
		local ground, hit = self:_snapGround(c.point)
		if hit then
			tried += 1
			local path = self:_newPath(origin, ground)
			if self:_stale(gen) then
				return nil
			end
			if path then
				return { path = path, dest = ground }
			end
		end
	end
	return nil
end

function Navigator:_compute(gen: number, target: Vector3, useAlt: boolean)
	local origin = self.root.Position
	local dest = self:_snapGround(target)
	if not useAlt then
		local path = self:_newPath(origin, dest)
		if self:_stale(gen) then
			return
		end
		if path then
			self:_applyPath(path, dest, false)
			return
		end
	end
	local alt = self:_findAlternate(origin, dest, gen)
	if self:_stale(gen) then
		return
	end
	if alt then
		self:_applyPath(alt.path, alt.dest, true)
	elseif self.waypoints == nil then
		self:_fail("no-path")
	else
		self.lastRepathReason = (self.lastRepathReason or "") .. " (no path; keeping current)"
	end
end

function Navigator:_applyPath(path: Path, dest: Vector3, isAlt: boolean)
	local wps = path:GetWaypoints()
	if #wps == 0 then
		if self.waypoints == nil then
			self:_fail("empty-path")
		end
		return
	end
	self:_disconnectBlocked()
	self.waypoints = wps
	self.wpIndex = if #wps &gt;= 2 then 2 else 1
	self.pathVersion += 1
	self.destination = dest
	self.usedAlternate = isAlt
	self.status = "Moving"
	self.bestDist = math.huge
	self.lastProgressAt = os.clock()
	self.lastMoveCmdAt = -math.huge
	self.cmdIndex = 0
	self.blockedConn = path.Blocked:Connect(function(blockedIdx: number)
		if not self.destroyed and self.waypoints == wps and blockedIdx &gt;= self.wpIndex then
			self.blockedCount += 1
			self:_requestPath("blocked at waypoint " .. blockedIdx, true)
		end
	end)
end

local function isIncapacitated(hum: Humanoid): boolean
	if hum.Sit or hum.PlatformStand then
		return true
	end
	local s = hum:GetState()
	return s == Enum.HumanoidStateType.Ragdoll or s == Enum.HumanoidStateType.FallingDown or s == Enum.HumanoidStateType.Physics
end

function Navigator:step(now: number)
	if self.destroyed then
		return
	end
	local status = self.status
	if status ~= "Moving" and status ~= "Computing" then
		return
	end
	local hum, cfg = self.humanoid, self.cfg
	if hum.Health &lt;= 0 then
		self:_fail("agent-dead")
		return
	end

	if isIncapacitated(hum) then
		self.incapSince = self.incapSince or now
		self.lastProgressAt = now
		if now - self.incapSince &gt; cfg.incapacitatedTimeout then
			self:_fail("incapacitated")
		end
		return
	end
	self.incapSince = nil

	if self.pendingRepath then
		self:_requestPath(self.pendingRepath, false)
	end

	if status == "Computing" then
		if now - self.goalStartedAt &gt; cfg.computeTimeout and self.inflight == 0 then
			self:_fail("compute-timeout")
		elseif now - self.goalStartedAt &gt; cfg.computeTimeout * 2 then
			self:_fail("compute-timeout")
		end
		return
	end

	local pos = self.root.Position
	if self.sidewaysFacing then
		self.root.CFrame = CFrame.lookAt(pos, pos + self.sidewaysFacing)
		self.root.AssemblyAngularVelocity = Vector3.zero
	end

	self.distSinceRecovery += flatDistance(pos, self.lastPos)
	self.lastPos = pos
	if self.attempts &gt; 0 and self.distSinceRecovery &gt;= cfg.recoveryResetDistance then
		self.attempts = 0
		self.distSinceRecovery = 0
	end

	if now &lt; self.sidestepUntil then
		hum:MoveTo(self.sidestepPoint)
		return
	elseif self.sidestepUntil &gt; 0 then
		self.sidestepUntil = 0
		self.lastProgressAt = now
		self:_requestPath("after sidestep", true)
	end

	local wps = self.waypoints
	if wps == nil then
		return
	end

	local feetY = pos.Y - (hum.HipHeight + self.root.Size.Y * 0.5)
	while self.wpIndex &lt;= #wps do
		local wp = wps[self.wpIndex]
		local tol = if self.wpIndex == #wps then self.arrivalTol else cfg.waypointTolerance
		if flatDistance(pos, wp.Position) &lt;= tol and math.abs(feetY - wp.Position.Y) &lt;= cfg.verticalTolerance then
			self.wpIndex += 1
			self.bestDist = math.huge
			self.lastProgressAt = now
		else
			break
		end
	end

	if self.wpIndex &gt; #wps then
		self:_onPathEnd(now)
		return
	end

	local wp = wps[self.wpIndex]
	local flat = flatDistance(pos, wp.Position)

	if wp.Action == Enum.PathWaypointAction.Jump and self.ctrl.profile.agent.canJump and flat &lt;= cfg.jumpTriggerDistance and self.jumpedIndex ~= self.wpIndex then
		self.jumpedIndex = self.wpIndex
		hum.Jump = true
	end

	local line = self.crossLine
	if line then
		local rel = Vector3.new(pos.X - line.origin.X, 0, pos.Z - line.origin.Z)
		local t = math.clamp(rel:Dot(line.axis) + self.ctrlConfig.gap.crossLookahead, 0, line.length)
		local aim = line.origin + line.axis * t
		hum:MoveTo(Vector3.new(aim.X, wp.Position.Y, aim.Z))
		self.cmdIndex = self.wpIndex
		self.lastMoveCmdAt = now
	elseif self.cmdIndex ~= self.wpIndex or now - self.lastMoveCmdAt &gt;= cfg.moveCommandInterval then
		hum:MoveTo(wp.Position)
		self.cmdIndex = self.wpIndex
		self.lastMoveCmdAt = now
	end

	if flat &lt; self.bestDist - cfg.minProgressDistance then
		self.bestDist = flat
		self.lastProgressAt = now
	elseif now - self.lastProgressAt &gt;= cfg.stuckTimeout then
		if self.wpIndex == #wps and flat &lt;= self.arrivalTol + 1 then
			self:_arrive()
			return
		end
		self:_onStuck(now, flat)
	end
end

function Navigator:_onPathEnd(now: number)
	local pos = self.root.Position
	local dest = self.destination or self.requested
	if self.routeMode then
		self:_arrive()
		return
	end
	if flatDistance(pos, dest) &lt;= self.arrivalTol + 0.5 then
		self:_arrive()
		return
	end

	if self.inflight &gt; 0 or self.pendingRepath then
		return
	end
	self.attempts += 1
	self.lastRecoveryNote = ("path ended %.1f studs from destination"):format(flatDistance(pos, dest))
	if self.attempts &gt; self.cfg.maxRecoveryAttempts then
		self:_fail("path-end-mismatch")
	else
		self:_requestPath("path ended short", true)
	end
end

function Navigator:_onStuck(now: number, distanceToWaypoint: number)
	local cfg = self.cfg
	self.attempts += 1
	self.distSinceRecovery = 0
	self.lastProgressAt = now
	self.bestDist = math.huge
	if self.sidewaysFacing then
		self.lastRecoveryNote = "stuck while crossing sideways"
		self:_fail("stuck")
		return
	end
	self.lastRecoveryNote = ("stuck #%d: no progress to waypoint %d (%.1f studs left)"):format(self.attempts, self.wpIndex, distanceToWaypoint)

	if self.attempts &gt; cfg.maxRecoveryAttempts or (self.routeMode and self.attempts &gt;= 3) then
		self:_fail("stuck")
		return
	end

	local a = self.attempts
	if a == 1 then
		if self.ctrl.profile.agent.canJump then
			self.humanoid.Jump = true
		end
		self:_requestPath("stuck: jump + repath", true)
	elseif a == 2 then
		self.sideSign = -self.sideSign
		self.sidestepPoint = self.root.Position + self.root.CFrame.RightVector * (cfg.sidestepDistance * self.sideSign)
		self.sidestepUntil = now + cfg.sidestepDuration
	else
		self.useAlternate = true
		self:_requestPath("stuck: alternate reachable point", true)
	end
end

return Navigator
</ProtectedString>
